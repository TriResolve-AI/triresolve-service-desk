#############################################
# TriResolve AI - Environment Configuration
# -------------------------------------------
# This file defines the required environment
# variables for local development.
#
# IMPORTANT:
# - DO NOT put real secrets in this file.
# - DO NOT commit your actual .env file.
# - Use RAW VALUES (NO quotes).
# - Your real secrets belong ONLY in:
#     1. Local `.env` (ignored by Git)
#     2. GitHub Repository Secrets
#     3. Streamlit Cloud Secrets (if deployed)
#############################################

###############
# Azure Core
###############
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_KEY_HERE
AZURE_LOCATION=eastus

#########################################
# TriResolve AI Agent Deployments (Foundry)
# -----------------------------------------
# These values must match your Azure AI Foundry
# agent deployment names EXACTLY.
#########################################

# System Orchestrator
AZURE_OPENAI_DEPLOYMENT_ORCHESTRATOR=triresolve-orchestrator

# Classifier Agent (Intent Router)
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=triresolve-classifier

# Domain Agents
AZURE_OPENAI_DEPLOYMENT_HR=triresolve-hr
AZURE_OPENAI_DEPLOYMENT_IT=triresolve-it
AZURE_OPENAI_DEPLOYMENT_FINANCE=triresolve-finance

# Specialist Agents
AZURE_OPENAI_DEPLOYMENT_ARCHITECT=triresolve-architect
AZURE_OPENAI_DEPLOYMENT_SECURITY=triresolve-security
AZURE_OPENAI_DEPLOYMENT_OPS=trinexa-ops-agent

##################################################
# Optional Future Variables (Uncomment as needed)
##################################################

# STREAMLIT_AUTH_TOKEN=
# LOG_LEVEL=INFO
# APP_ENV=development

##################################################
# END OF CONFIG
##################################################
