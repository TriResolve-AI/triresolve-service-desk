#############################################
# TriResolve AI - Local Environment Example
# ------------------------------------------
# Copy this file to `.env` for local dev and
# fill in your real values. Do NOT commit `.env`.
#############################################

# ===== Azure OpenAI Core =====
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_LOCAL_DEV_KEY
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_LOCATION=eastus

# ===== TriResolve / TriNexa Agents (Foundry) =====
# These MUST match the agent deployment names in Azure AI Foundry.

# System Orchestrator
AZURE_OPENAI_DEPLOYMENT_ORCHESTRATOR=triresolve-orchestrator

# Classifier
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=triresolve-classifier

# Domain agents
AZURE_OPENAI_DEPLOYMENT_HR=triresolve-hr
AZURE_OPENAI_DEPLOYMENT_IT=triresolve-it
AZURE_OPENAI_DEPLOYMENT_FINANCE=triresolve-finance

# Specialist agents
AZURE_OPENAI_DEPLOYMENT_ARCHITECT=trinexa-architect-agent
AZURE_OPENAI_DEPLOYMENT_SECURITY=trinexa-security-agent
AZURE_OPENAI_DEPLOYMENT_OPS=trinexa-ops-agent
