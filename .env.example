#############################################
# TriResolve AI - Environment Configuration
# SAFE TEMPLATE VERSION — NO REAL SECRETS
#############################################

###########################
# Azure OpenAI Core
###########################
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR-API-KEY-HERE
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_LOCATION=eastus

#########################################
# TriResolve Agent Deployment Names
# (Must match Azure AI Foundry agent names)
#########################################

# Core system agents
AZURE_OPENAI_DEPLOYMENT_ORCHESTRATOR=triresolve-orchestrator
AZURE_OPENAI_DEPLOYMENT_CLASSIFIER=triresolve-classifier

# Domain agents
AZURE_OPENAI_DEPLOYMENT_IT=triresolve-it
AZURE_OPENAI_DEPLOYMENT_HR=triresolve-hr
AZURE_OPENAI_DEPLOYMENT_FINANCE=triresolve-finance

# Specialist agents
AZURE_OPENAI_DEPLOYMENT_ARCHITECT=trinexa-architect-agent
AZURE_OPENAI_DEPLOYMENT_SECURITY=trinexa-security-agent
AZURE_OPENAI_DEPLOYMENT_OPS=trinexa-ops-agent

#########################################
# Optional / Infra (used by CI or tooling)
#########################################
AZURE_SUBSCRIPTION_ID=YOUR-SUBSCRIPTION-ID
AZURE_TENANT_ID=YOUR-TENANT-ID
AZURE_RESOURCE_GROUP=YOUR-RESOURCE-GROUP
AZURE_AIPROJECT_ENDPOINT=https://YOUR-AI-PROJECT-ENDPOINT
AZURE_AIPROJECT_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Project/resourceName

# STREAMLIT_AUTH_TOKEN=
# LOG_LEVEL=INFO
# APP_ENV=development
